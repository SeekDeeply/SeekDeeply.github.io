---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import type { Post } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // getStaticPaths 里不能直接调用 render，放到组件里做
      prev: posts[i + 1] ? { id: posts[i + 1]!.id, title: posts[i + 1]!.data.title } : undefined,
      next: posts[i - 1] ? { id: posts[i - 1]!.id, title: posts[i - 1]!.data.title } : undefined,
    },
  }));
}

type Props = {
  post: Post;
  prev?: { id: string; title: string };
  next?: { id: string; title: string };
};

const { post, prev, next } = Astro.props as Props;
const { Content } = await render(post);
---

<PostLayout post={post} body={post.body ?? ''} prev={prev} next={next}>
  <Content />
</PostLayout>
