---
import BaseLayout from '../layouts/BaseLayout.astro';
import Glyph from '../components/Glyph.astro';
import { SITE } from '../site.config';
import { BASE } from '../consts';
---

<BaseLayout
  title="搜索"
  description={`在 ${SITE.name} 内搜索文章。`}
>
  <section class="section" data-pagefind-ignore>
    <div class="shell shell--narrow">
      <div class="page__head">
        <h1 class="page__title">
          <Glyph size={14} tone="accent" />
          搜索
        </h1>
        <span class="page__aside" id="search-count" aria-live="polite"></span>
      </div>

      <form class="search-form" role="search" id="search-form" autocomplete="off">
        <label for="search-input" class="visually-hidden">搜索关键词</label>
        <input
          class="search-input"
          id="search-input"
          name="q"
          type="search"
          placeholder="搜索标题或正文，例如：流水线"
          aria-describedby="search-help"
          enterkeyhint="search"
        />
      </form>

      <p class="search-status" id="search-help" aria-live="polite">输入关键词，结果实时出现在下方。</p>

      <ul class="search-results" id="search-results"></ul>
    </div>
  </section>
</BaseLayout>

<script>
  const BASE_URL: string = import.meta.env.BASE_URL;
  const form = document.getElementById('search-form') as HTMLFormElement | null;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const list = document.getElementById('search-results') as HTMLUListElement | null;
  const status = document.getElementById('search-help') as HTMLParagraphElement | null;
  const countEl = document.getElementById('search-count') as HTMLSpanElement | null;

  type PagefindResult = {
    url: string;
    excerpt: string;
    meta: { title?: string };
  };

  type PagefindApi = {
    options: (opts: Record<string, unknown>) => Promise<void>;
    debouncedSearch: (term: string, options?: Record<string, unknown>) => Promise<{ results: { data: () => Promise<PagefindResult> }[] } | null>;
  };

  let pagefind: PagefindApi | null = null;
  let loading: Promise<PagefindApi | null> | null = null;

  function setStatus(text: string) {
    if (status) status.textContent = text;
  }

  function setCount(text: string) {
    if (countEl) countEl.textContent = text;
  }

  function render(results: PagefindResult[]) {
    if (!list) return;
    list.replaceChildren();

    for (const result of results) {
      const li = document.createElement('li');
      li.className = 'search-result';

      const a = document.createElement('a');
      a.className = 'search-result__title';
      a.href = result.url;
      a.textContent = result.meta.title ?? '未命名';

      const url = document.createElement('span');
      url.className = 'search-result__url';
      url.textContent = result.url;

      const excerpt = document.createElement('p');
      excerpt.className = 'search-result__excerpt';
      // Pagefind 的 excerpt 是已经转义并高亮好的 HTML
      excerpt.innerHTML = result.excerpt;

      li.append(a, url, excerpt);
      list.append(li);
    }
  }

  async function loadPagefind(): Promise<PagefindApi | null> {
    if (pagefind) return pagefind;
    if (loading) return loading;

    loading = (async () => {
      try {
        const mod = (await import(/* @vite-ignore */ `${BASE_URL}pagefind/pagefind.js`)) as PagefindApi;
        await mod.options({ baseUrl: BASE_URL });
        pagefind = mod;
        return mod;
      } catch (error) {
        console.warn('[search] Pagefind 索引不可用', error);
        return null;
      }
    })();

    return loading;
  }

  async function run(term: string) {
    const query = term.trim();

    if (!query) {
      list?.replaceChildren();
      setStatus('输入关键词，结果实时出现在下方。');
      setCount('');
      return;
    }

    setStatus('搜索中…');
    const api = await loadPagefind();

    if (!api) {
      setStatus('搜索索引尚未生成。索引由 CI 在构建后创建，本地开发时不可用。');
      setCount('');
      return;
    }

    const search = await api.debouncedSearch(query);
    if (!search) return;

    const results = await Promise.all(search.results.slice(0, 20).map((r) => r.data()));
    render(results);

    if (results.length === 0) {
      setStatus(`没有找到与「${query}」相关的文章。`);
      setCount('0 条');
    } else {
      setStatus(`找到 ${results.length} 条结果。`);
      setCount(`${results.length} 条`);
    }
  }

  let timer: number | undefined;

  input?.addEventListener('input', () => {
    window.clearTimeout(timer);
    const value = input.value;
    timer = window.setTimeout(() => void run(value), 120);
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    window.clearTimeout(timer);
    void run(input?.value ?? '');
  });

  const initial = new URLSearchParams(window.location.search).get('q');
  if (initial && input) {
    input.value = initial;
    void run(initial);
  }
</script>
