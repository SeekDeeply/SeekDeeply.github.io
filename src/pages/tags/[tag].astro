---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import TagChips from '../../components/TagChips.astro';
import Glyph from '../../components/Glyph.astro';
import { SITE, tagToSlug } from '../../site.config';
import { p } from '../../consts';
import { countByTag, getPublishedPosts, readingMinutes, type Post } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const counts = Object.fromEntries(countByTag(posts));

  return SITE.tags.map((tag) => ({
    params: { tag: tagToSlug(tag.label) },
    props: {
      label: tag.label,
      posts: posts.filter((post) => post.data.tags.includes(tag.label)),
      counts,
    },
  }));
}

type Props = { label: string; posts: Post[]; counts: Record<string, number> };

const { label, posts, counts } = Astro.props as Props;
const allLabels = SITE.tags.map((tag) => tag.label);
---

<BaseLayout
  title={`标签：${label}`}
  description={`${SITE.name} 中标记为「${label}」的文章，共 ${posts.length} 篇。`}
>
  <section class="section">
    <div class="shell">
      <div class="page__head">
        <h1 class="page__title">
          <Glyph size={14} tone="accent" />
          {label}
        </h1>
        <a class="section__more" href={p('/tags')}>全部标签 →</a>
      </div>

      <div style="margin-bottom: 1.5rem;">
        <TagChips tags={allLabels} current={label} counts={counts} />
      </div>

      {
        posts.length > 0 ? (
          <ul class="post-list">
            {posts.map((post) => (
              <PostCard post={post} readingTime={readingMinutes(post.body ?? '')} />
            ))}
          </ul>
        ) : (
          <div class="empty">这个格子还没被点亮。</div>
        )
      }
    </div>
  </section>
</BaseLayout>
