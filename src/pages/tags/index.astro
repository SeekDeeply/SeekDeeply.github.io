---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Glyph from '../../components/Glyph.astro';
import { SITE, tagToSlug } from '../../site.config';
import { p } from '../../consts';
import { countByTag, getPublishedPosts } from '../../lib/content';

const posts = await getPublishedPosts();
const counts = [...countByTag(posts).entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-Hans-CN'),
);
const labels = SITE.tags.map((tag) => tag.label).join('、');
---

<BaseLayout title="标签" description={`${SITE.name} 的全部标签：${labels}。`}>
  <section class="section">
    <div class="shell">
      <div class="page__head">
        <h1 class="page__title">
          <Glyph size={14} tone="accent" />
          标签
        </h1>
        <span class="page__aside">{posts.length} 篇 · {counts.length} 个格子</span>
      </div>

      <ul class="tag-grid">
        {
          counts.map(([label, count]) => (
            <li>
              <a class="tag-card" href={p(`/tags/${tagToSlug(label)}`)}>
                <span class="tag-card__name">
                  <Glyph size={12} tone="accent" />
                  {label}
                </span>
                <span class="tag-card__count">{count} 篇</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
