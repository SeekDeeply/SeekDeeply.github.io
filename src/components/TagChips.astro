---
import { p } from '../consts';
import { tagToSlug } from '../site.config';

interface Props {
  /** 标签的展示名（中文） */
  tags: string[];
  /** 当前页面对应的标签名 */
  current?: string;
  /** 标签名 → 文章数 */
  counts?: Record<string, number>;
}

const { tags, current, counts } = Astro.props;
---

<ul class="tag-row">
  {
    tags.map((tag) => (
      <li>
        <a
          class="tag-chip"
          href={p(`/tags/${tagToSlug(tag)}`)}
          aria-current={current === tag ? 'page' : undefined}
        >
          <span>{tag}</span>
          {counts && typeof counts[tag] === 'number' && (
            <span class="tag-chip__count">{counts[tag]}</span>
          )}
        </a>
      </li>
    ))
  }
</ul>
